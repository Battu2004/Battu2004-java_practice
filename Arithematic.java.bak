class Arithematic 
{
	public static void main(String[] args) 
	{
		int a=10;
		int b=20;
		int c=a+b;
		System.out.println(c);

		 a=10;
		 b=20;
		 c=a*b;

		System.out.println(c);

		 a=10;
		 b=20;
		 c=a-b;

		System.out.println(c);

		a=10;
		 b=20;
		c=a/b;

		System.out.println(c);

		 a=10;
		 b=20;
		c=a%b;

		System.out.println(c);

	}
}
