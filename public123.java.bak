class public123 
{
	public static void main(String[] args) 
	{
		int a=12;
		int b=23;
		boolean res=(a==b&&a!=b);
		System.out.println("res="+res);
		System.out.println(a<b&&a!=b);
		System.out.println(a==b&&a<b);
		System.out.println(a==b&&a>b);
		System.out.println(a<b&&a!=b);
		System.out.println(a==b&&a<=b);
		System.out.println(a==b&&a>=b);
		System.out.println(a!=b&&a>b);
		System.out.println(a!=b&&a<=b);
		System.out.println(a!=b&&a>=b);
		System.out.println(a<b&&a==b);
		System.out.println(a<b&&a>b);
		System.out.println(a<b&&a<=b);
		System.out.println(a<b&&a>=b);
		System.out.println(a>b&&a==b);
		System.out.println(a>b&&a!=b);
		System.out.println(a>b&&a<=b);
		System.out.println(a>b&&a>=b);


	}
}
